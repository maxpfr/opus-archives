---
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, siteUrl, isPlaceholder } from '../../site.config';
import { useTranslations, routes, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Route key used to build canonical and hreflang alternates. */
  page: keyof (typeof routes)['fr'];
  /** Whether the header shows in-page section links. */
  homeNav?: boolean;
}

const { lang, title, description, page, homeNav = false } = Astro.props;
const { dict } = useTranslations(lang);

const path = routes[lang][page];
const canonical = siteUrl ? new URL(path, siteUrl).href : null;
const alternates = (site.englishEnabled ? (['fr', 'en'] as const) : (['fr'] as const)).map((l) => ({
  lang: l,
  href: siteUrl ? new URL(routes[l][page], siteUrl).href : null,
}));

// JSON-LD: confirmed fields only. URL and email are added once they are no longer placeholders.
const { legal } = site;
const organization: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.brand,
  legalName: legal.companyName,
  identifier: { '@type': 'PropertyValue', propertyID: 'SIREN', value: legal.siren.replace(/\s/g, '') },
  address: {
    '@type': 'PostalAddress',
    streetAddress: legal.streetAddress,
    postalCode: legal.postalCode,
    addressLocality: legal.city,
    addressCountry: legal.country,
  },
  founder: { '@type': 'Person', name: site.founder.name },
};
if (siteUrl) organization.url = siteUrl;
if (!isPlaceholder(site.email)) organization.email = site.email;
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#faf8f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1522" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => a.href && <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {alternates[0].href && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={dict.meta.locale} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />

    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    {page === 'home' && <script type="application/ld+json" set:html={JSON.stringify(organization)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{dict.a11y.skip}</a>
    <Header lang={lang} page={page} homeNav={homeNav} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
