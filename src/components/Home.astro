---
import TwoTone from './TwoTone.astro';
import PixelArt from './PixelArt.astro';
import { site, isPlaceholder } from '../../site.config';
import { useTranslations, routes, withBase, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { dict, t } = useTranslations(lang);
const L = dict.labels;

const mailto = `mailto:${site.email}?subject=${encodeURIComponent(t(dict.contact.emailSubject))}&body=${encodeURIComponent(dict.contact.emailBody)}`;
const mailtoPlain = `mailto:${site.email}?subject=${encodeURIComponent(t(dict.contact.emailSubject))}`;
const showPhone = site.phone !== '';
const showLinkedin = !isPlaceholder(site.founder.linkedin);
const dataProtocolPdf = site.documents.dataProtocolPdf && withBase(site.documents.dataProtocolPdf);
const presentationPdf = site.documents.presentationPdf && withBase(site.documents.presentationPdf);
const pad = (i: number) => String(i + 1).padStart(2, '0');
const liquidatorsTab = dict.process.tabs[1];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero-grid">
      <div>
        <span class="label">{dict.hero.eyebrow}</span>
        <h1 id="hero-title"><span class="sq" aria-hidden="true"></span><TwoTone text={t(dict.hero.title)} /></h1>
        <p class="hero-lead">{t(dict.hero.lead)}</p>
        <p class="hero-sub">{t(dict.hero.sub)}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="#contact">{dict.hero.ctaPrimary}</a>
          <a class="btn btn-outline" href={`#panel-${liquidatorsTab.id}`} data-tab-link>{dict.hero.ctaLiquidators}</a>
        </div>
      </div>
      <div class="hero-art"><PixelArt /></div>
    </div>
    <ul class="facts">
      {dict.hero.facts.map((f) => <li>{t(f)}</li>)}
    </ul>
  </div>
</section>

<section id="valeur" aria-labelledby="valeur-title">
  <div class="container">
    <div class="inner">
      <div class="section-head">
        <span class="label">{dict.value.label}</span>
        <h2 id="valeur-title"><span class="sq" aria-hidden="true"></span><TwoTone text={t(dict.value.title)} /></h2>
        <p>{t(dict.value.intro)}</p>
      </div>
      <ol class="numbered">
        {
          dict.value.chain.map((item) => (
            <li>
              <h3>{t(item.title)}</h3>
              <p>{t(item.text)}</p>
            </li>
          ))
        }
      </ol>
      <p class="usage">{t(dict.value.usage)}</p>
    </div>
  </div>
</section>

<section id="remuneration" aria-labelledby="remuneration-title">
  <div class="container">
    <div class="inner">
      <div class="section-head rule">
        <span class="label">{dict.economics.label}</span>
        <h2 id="remuneration-title"><span class="sq" aria-hidden="true"></span><TwoTone text={t(dict.economics.title)} /></h2>
        <p>{t(dict.economics.intro)}</p>
      </div>
      <dl class="qa-grid">
        {
          dict.economics.items.map((item) => (
            <div>
              <dt>{t(item.q)}</dt>
              <dd>{t(item.a)}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<section id="pour-qui" aria-labelledby="pour-qui-title">
  <div class="container">
    <div class="inner">
      <div class="section-head rule">
        <span class="label">{dict.useCases.label}</span>
        <h2 id="pour-qui-title"><span class="sq" aria-hidden="true"></span><TwoTone text={t(dict.useCases.title)} /></h2>
        <p>{t(dict.useCases.intro)}</p>
      </div>
      <div class="grid-cells grid-cells-4">
        {
          dict.useCases.items.map((item, i) => (
            <article>
              <span class="num" aria-hidden="true">{pad(i)}</span>
              <h3>{t(item.title)}</h3>
              <p>{t(item.text)}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<section id="perimetre" aria-labelledby="perimetre-title">
  <div class="container">
    <div class="inner">
      <div class="section-head">
        <h2 id="perimetre-title"><span class="sq" aria-hidden="true"></span><TwoTone text={t(dict.scope.title)} /></h2>
        <p>{t(dict.scope.intro)}</p>
      </div>
      <div class="twin">
        <div class="card">
          <span class="label">{L.buy}</span>
          <h3><span class="sq sq-sand" aria-hidden="true"></span>{t(dict.scope.buy.title)}</h3>
          <ul>{dict.scope.buy.items.map((item) => <li>{t(item)}</li>)}</ul>
        </div>
        <div class="card card-paper">
          <span class="label">{L.notBuy}</span>
          <h3><span class="sq sq-ink" aria-hidden="true"></span>{t(dict.scope.notBuy.title)}</h3>
          <ul>{dict.scope.notBuy.items.map((item) => <li>{t(item)}</li>)}</ul>
        </div>
      </div>
      <p class="note">{t(dict.scope.note)}</p>
    </div>
  </div>
</section>

<section id="processus" aria-labelledby="processus-title">
  <div class="container">
    <div class="inner">
      <div class="section-head rule">
        <span class="label">{L.process}</span>
        <h2 id="processus-title"><span class="sq" aria-hidden="true"></span><TwoTone text={t(dict.process.title)} /></h2>
        <p>{t(dict.process.intro)}</p>
      </div>
      <div class="tabs" data-tabs>
        <div class="tablist" role="tablist" aria-label={dict.process.tabsLabel}>
          {
            dict.process.tabs.map((tab, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${tab.id}`}
                aria-controls={`panel-${tab.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                {tab.label}
              </button>
            ))
          }
        </div>
        {
          dict.process.tabs.map((tab) => (
            <div class="tabpanel" role="tabpanel" id={`panel-${tab.id}`} aria-labelledby={`tab-${tab.id}`}>
              <h3 class="panel-title">{tab.label}</h3>
              {'lead' in tab && tab.lead && <p class="panel-lead">{t(tab.lead)}</p>}
              <div class="panel-body">
                <ol class="steps">
                  {tab.steps.map((s, i) => (
                    <li>
                      <span class="step-num">{pad(i)}</span>
                      <div>
                        <h4>{t(s.title)}</h4>
                        <p>{t(s.text)}</p>
                        {'detail' in s && s.detail && (
                          <details class="step-detail">
                            <summary>{'detailLabel' in tab ? tab.detailLabel : ''}</summary>
                            <p>{t(s.detail)}</p>
                          </details>
                        )}
                      </div>
                    </li>
                  ))}
                </ol>
                <aside class="aside" aria-label={t(tab.aside.title)}>
                  <h4>{t(tab.aside.title)}</h4>
                  <ul>
                    {tab.aside.items.map((item) => (
                      <li>{t(item)}</li>
                    ))}
                  </ul>
                </aside>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<section id="protection" aria-labelledby="protection-title">
  <div class="container">
    <div class="inner">
      <div class="section-head rule">
        <span class="label">{L.protection}</span>
        <h2 id="protection-title"><span class="sq" aria-hidden="true"></span><TwoTone text={t(dict.protection.title)} /></h2>
        <p>{t(dict.protection.intro)}</p>
      </div>
      <div class="grid-cells">
        {
          dict.protection.items.map((item, i) => (
            <article>
              <span class="num" aria-hidden="true">{pad(i)}</span>
              <h3>{t(item.title)}</h3>
              <p>{t(item.text)}</p>
            </article>
          ))
        }
      </div>
      <p class="note">{t(dict.protection.restriction)}</p>
      {
        (dataProtocolPdf || site.protocolValidatedByLawyer) && (
          <div class="doc-links">
            {/* TODO: dataProtocolPdf is empty until the "protocole de traitement des données" PDF is supplied. */}
            {dataProtocolPdf && (
              <a class="btn btn-outline" href={dataProtocolPdf} download>
                {dict.protection.pdf}
              </a>
            )}
            {/* TODO: protocolValidatedByLawyer stays false until a lawyer has actually validated the protocol. */}
            {site.protocolValidatedByLawyer && <p>{t(dict.protection.lawyer)}</p>}
          </div>
        )
      }
    </div>
  </div>
</section>

<section id="developpeurs-ia" aria-labelledby="ia-title">
  <div class="container">
    <div class="inner split">
      <div>
        <span class="label">{L.ai}</span>
        <h2 id="ia-title"><span class="sq" aria-hidden="true"></span><TwoTone text={t(dict.aiDevelopers.title)} /></h2>
      </div>
      <div>
        <p class="big">{t(dict.aiDevelopers.text)}</p>
        <ul class="checklist">{dict.aiDevelopers.items.map((item) => <li>{t(item)}</li>)}</ul>
        <a class="btn btn-outline" href={mailtoPlain}>{dict.aiDevelopers.cta}</a>
      </div>
    </div>
  </div>
</section>

<section id="faq" aria-labelledby="faq-title">
  <div class="container">
    <div class="inner faq-grid rule">
      <div>
        <span class="label">{L.faq}</span>
        <h2 id="faq-title"><span class="sq" aria-hidden="true"></span><TwoTone text={t(dict.faq.title)} /></h2>
      </div>
      <div class="faq-list">
        {
          dict.faq.items.map((item) => (
            <details>
              <summary>{t(item.q)}</summary>
              <p>{t(item.a)}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<section id="a-propos" aria-labelledby="about-title">
  <div class="container">
    <div class="inner about-grid">
      <div>
        <span class="label">{L.about}</span>
        <h2 id="about-title"><span class="sq" aria-hidden="true"></span><TwoTone text={t(dict.about.title)} /></h2>
      </div>
      <div>
        {dict.about.lines.map((line) => <p>{t(line)}</p>)}
        {
          showLinkedin && (
            <p>
              <a href={site.founder.linkedin} rel="noopener" target="_blank">
                {dict.about.linkedin} <span class="visually-hidden">{dict.a11y.external}</span>
              </a>
            </p>
          )
        }
      </div>
    </div>
  </div>
</section>

<section id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="inner cta-band">
      <div>
        <span class="label">{L.contact}</span>
        <h2 id="contact-title"><span class="sq" aria-hidden="true"></span><TwoTone text={t(dict.contact.title)} /></h2>
        <p>{t(dict.contact.text)}</p>
        <div class="contact-meta">
          <span>{site.email}</span>
          {
            showPhone && (
              <span>
                {t(dict.contact.phone)} <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>
              </span>
            )
          }
        </div>
        <p class="small">
          {t(dict.contact.notice)} <a href={routes[lang].privacy}>{dict.contact.noticeLink}</a>.
        </p>
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" href={mailto}>{dict.contact.email}</a>
        {/* TODO: presentationPdf is empty until the two-page "Présentation de la démarche" PDF is supplied. */}
        {
          presentationPdf && (
            <a class="btn btn-outline" href={presentationPdf} download>
              {dict.contact.presentationPdf}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Progressive enhancement: without JS both process panels are shown one after the other.
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      }
      if (focus) tab.focus();
    };
    const fromHash = () => tabs.find((t) => `#${t.getAttribute('aria-controls')}` === location.hash);
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const keys: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
        if (!(e.key in keys)) return;
        e.preventDefault();
        select(tabs[(keys[e.key] + tabs.length) % tabs.length], true);
      });
    });
    // Hero links point at a panel: open that tab, then scroll to the section.
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-tab-link]')) {
      link.addEventListener('click', (e) => {
        const tab = tabs.find((t) => `#${t.getAttribute('aria-controls')}` === link.hash);
        if (!tab) return;
        e.preventDefault();
        select(tab);
        history.replaceState(null, '', link.hash);
        root.closest('section')?.scrollIntoView();
      });
    }
    select(fromHash() ?? tabs[0]);
  }
</script>
