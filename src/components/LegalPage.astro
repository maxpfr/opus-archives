---
import Base from '../layouts/Base.astro';
import { site } from '../../site.config';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  kind: 'legal' | 'privacy';
}

const { lang, kind } = Astro.props;
const { dict, t } = useTranslations(lang);
const content = kind === 'legal' ? dict.legalPage : dict.privacyPage;
---

<Base lang={lang} page={kind} title={`${t(content.title)} — ${site.brand}`} description={t(content.description)}>
  <div class="container">
    <article class="prose">
      <h1>{t(content.title)}</h1>
      {
        content.sections.map((section) => (
          <div>
            <h2>{t(section.title)}</h2>
            {section.lines.map((line) => <p>{t(line)}</p>)}
          </div>
        ))
      }
    </article>
  </div>
</Base>
