---
import Base from '../layouts/Base.astro';
import { useTranslations } from '../i18n';

const { dict, t } = useTranslations('fr');
const en = useTranslations('en').dict;
---

<Base lang="fr" page="home" title={`${dict.notFound.title} — 404`} description={dict.notFound.text}>
  <div class="container">
    <article class="prose">
      <h1>{dict.notFound.title}</h1>
      <p>{t(dict.notFound.text)}</p>
      <p><a href="/">{dict.notFound.back}</a></p>
      <p lang="en"><a href="/en/">{en.notFound.back}</a></p>
    </article>
  </div>
</Base>
